# --- Database ------------------------------------------------------------
# Local dev (default): SQLite, zero setup.
DATABASE_URL="file:./dev.db"
# Prod: switch prisma/schema.prisma datasource provider to "postgresql" and use:
# DATABASE_URL="postgresql://user:password@host:5432/xedusat"

# --- Auth (NextAuth) -------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="dev-secret-change-me"

# --- Stripe (optional — mock billing is used when these are empty) ---------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_PLUS=""
STRIPE_PRICE_PREMIUM=""

# --- Zoom (optional — mock meeting links are generated when empty) ---------
ZOOM_ACCOUNT_ID=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""

# --- Desmos (optional — basic calculator fallback when empty) --------------
NEXT_PUBLIC_DESMOS_API_KEY=""

# --- DeepSeek (optional) -------------------------------------------------
# Powers content-generation scripts and the Daily Reading AI summary feedback.
# Without it, Daily Reading uses a heuristic comprehension analysis.
DEEPSEEK_API_KEY=""

# --- News source (optional — Daily Reading) ------------------------------
# If set, the Daily Reading adapter can pull live articles (NewsAPI-compatible).
# Without it, the seeded original-article library is used.
NEWS_API_KEY=""

# --- Developer dashboard (hidden internal analytics) ---------------------
# bcrypt hash of the dev-portal password. Generate with:
#   node -e "console.log(require('bcryptjs').hashSync('yourpassword',12))"
DEV_DASHBOARD_PASSWORD_HASH=""
